APP_NAME=AtlasFlow
APP_ENV=development
LOG_LEVEL=INFO

# Runtime providers are real-only. Missing credentials fail with a clear error.
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

RERANK_PROVIDER=openrouter
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RERANK_API_KEY=
RERANK_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter search can reuse LLM_API_KEY when SEARCH_API_KEY is empty.
SEARCH_PROVIDER=openrouter
SEARCH_MODEL=
SEARCH_API_KEY=
SEARCH_BASE_URL=https://openrouter.ai/api/v1

# LangSmith is optional. Content upload is opt-in to reduce accidental data exposure.
LANGSMITH_TRACING=false
LANGSMITH_TRACE_CONTENT=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlasflow-dev

# Operational Run/Event database. Omit to use <repo>/data/atlasflow.sqlite3.
# DATABASE_PATH=./data/atlasflow.sqlite3
REDIS_URL=redis://localhost:6379/0

# Server-Sent Events reconnect/heartbeat settings.
SSE_HEARTBEAT_SECONDS=10
SSE_POLL_SECONDS=0.25

# Agent orchestration budgets. These are hard safety bounds, not quality targets.
MAX_RESEARCH_TASKS=5
MAX_RESEARCH_CONCURRENCY=3
MAX_RESEARCH_ATTEMPTS=2
RESEARCH_QUORUM_RATIO=0.6
MAX_SUPPLEMENT_ROUNDS=1
MAX_SUPPLEMENT_TASKS=2
MAX_TASKS_PER_PLAN=7
MAX_REPLANS=1
MAX_REPORT_REVISIONS=2
QUALITY_THRESHOLD=80
MAX_TOOL_RETRIES=2
TOOL_TIMEOUT_SECONDS=120
PROVIDER_TIMEOUT_SECONDS=90
RAG_TOP_K=5
