# Copy to .env and keep actual keys private. Local paths stay on E:.
APP_NAME=AtlasFlow

# Agent model. Only OpenRouter is supported; use a model that supports JSON and tool calling.
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter/free
# Optional extra chat-model choices for evaluation dropdowns; primary LLM_MODEL is always included.
# JSON array of identifiers on the SAME configured LLM service, e.g. ["provider/model-b"].
LLM_MODEL_OPTIONS=[]
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# RAG embedding and reranking are required when the backend starts.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

RERANK_PROVIDER=openrouter
RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RERANK_API_KEY=
RERANK_BASE_URL=https://openrouter.ai/api/v1

# Web search can reuse LLM_MODEL/LLM_API_KEY if SEARCH_MODEL/SEARCH_API_KEY are empty.
SEARCH_PROVIDER=openrouter
SEARCH_MODEL=
SEARCH_API_KEY=
SEARCH_BASE_URL=https://openrouter.ai/api/v1

# Optional map tools: AMap Web Service Key for POI and routes.
AMAP_API_KEY=

# Weather uses Open-Meteo's non-commercial free API by default. For commercial
# deployment, configure an Open-Meteo subscription key for customer endpoints.
OPEN_METEO_API_KEY=

# LangSmith is optional. TRACE_CONTENT=true uploads query, evidence and report text.
LANGSMITH_TRACING=false
LANGSMITH_TRACE_CONTENT=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlasflow-dev

# Run/Event database is SQLite; it is separate from the PostgreSQL knowledge store.
DATABASE_PATH=E:/codex/agent/data/atlasflow.sqlite3

# RAG knowledge store. PostgreSQL server data volume is configured in docker-compose.yml.
KNOWLEDGE_BACKEND=postgres
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/atlasflow
KNOWLEDGE_BLOB_ROOT=E:/codex/agent/data/knowledge/blobs
KNOWLEDGE_WORK_ROOT=E:/codex/tmp/atlasflow-rag
# Only legacy/API runs use this fallback; new web Runs choose a space or disable RAG.
KNOWLEDGE_DEFAULT_SPACE=user-default
KNOWLEDGE_WORKER_ENABLED=true

# Bilingual query expansion is query-time only; it does not rebuild the index.
# Keep the original query; allow at most 1-4 additional variants (default: 2).
KNOWLEDGE_QUERY_EXPANSION_ENABLED=true
KNOWLEDGE_QUERY_EXPANSION_LIMIT=2
# Optional UTF-8 JSON glossary extending built-in terms. Example: E:/codex/agent/data/knowledge/query-aliases.json
# Leave empty to use the built-in glossary; malformed custom files fail startup explicitly.
KNOWLEDGE_QUERY_ALIASES_PATH=

# 0.7执行恢复：留空复用KNOWLEDGE_DATABASE_URL；首次部署先初始化执行存储。
EXECUTION_DATABASE_URL=
# 独立评测库和导出目录（E盘）。
EVALUATION_STORAGE_ROOT=E:/codex/agent/data/evaluations
# 默认真实评测预算；实际HTTP尝试包含重试和工具内部请求。
EVALUATION_MAX_HTTP_ATTEMPTS=60
EVALUATION_MAX_SECONDS=1200
EVALUATION_CASE_TIMEOUT_SECONDS=90
EVALUATION_CONCURRENCY=2
# 独立Judge：默认关闭；Model/Key/BaseURL留空复用LLM配置；可单独覆盖。
EVALUATION_JUDGE_ENABLED=false
EVALUATION_JUDGE_MODEL=
# Judge输出预算（256-16384Token）与每项理由上限（40-600字符）。
EVALUATION_JUDGE_MAX_TOKENS=4096
EVALUATION_JUDGE_MAX_REASON_CHARS=160
EVALUATION_JUDGE_API_KEY=
EVALUATION_JUDGE_BASE_URL=
# 可选择同步LangSmith元数据，实验问题、原文及报告全文不上传。
EVALUATION_LANGSMITH_SYNC=true

# Optional server and Agent budgets; omit unchanged defaults in a local .env.
SSE_HEARTBEAT_SECONDS=10
SSE_POLL_SECONDS=0.25

# Agent orchestration budgets. These are hard safety bounds, not quality targets.
MAX_RESEARCH_TASKS=5
MAX_RESEARCH_CONCURRENCY=3
MAX_RESEARCH_ATTEMPTS=2
RESEARCH_QUORUM_RATIO=0.5
# 采纳有用的部分结果；置信度与覆盖率分开，有依据的结论保留模型自评分，不设置保底分。
RESEARCH_ACCEPT_PARTIAL_RESULTS=true
MAX_SUPPLEMENT_ROUNDS=1
MAX_SUPPLEMENT_TASKS=2
MAX_TASKS_PER_PLAN=7
MAX_REPLANS=1
MAX_REPORT_REVISIONS=1
# 质量通过分数50-100；默认50，风格/详略与已说明的非核心缺口不阻断，关键事实仍检查。
QUALITY_THRESHOLD=50
# 与RESEARCH_ACCEPT_PARTIAL_RESULTS同时为true时启用交付优先：一次局部修订、完整报告附局限。
# 不伪造质量通过；服务异常或证据缺口仍可显示completed_with_warnings，取消/执行存储错误不吞掉。
QUALITY_RELAXED_REVIEW=true
MAX_TOOL_RETRIES=2
TOOL_TIMEOUT_SECONDS=120
# web_fetch的单地址连接、单次网络读取及整体上限（秒）。
# 整体上限还会受TOOL_TIMEOUT_SECONDS约束；不会自动使用系统代理或降级HTTPS。
WEB_FETCH_CONNECT_TIMEOUT_SECONDS=8
WEB_FETCH_READ_TIMEOUT_SECONDS=20
WEB_FETCH_TOTAL_TIMEOUT_SECONDS=35
PROVIDER_TIMEOUT_SECONDS=90
